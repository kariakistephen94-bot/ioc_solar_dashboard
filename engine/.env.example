# Copy to .env. Never commit .env.
PORT=3310
# Any long random string. The dashboard uses the same value as ENGINE_API_TOKEN.
ENGINE_API_TOKEN=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase -> Project Settings -> API -> service_role key (server only)
SUPABASE_SERVICE_KEY=
OPENAI_API_KEY=
# gpt-4.1-mini is cheap and good enough for short WhatsApp replies
OPENAI_MODEL=gpt-4.1-mini
# Optional: an OpenAI-compatible endpoint (proxy or gateway). Leave empty for api.openai.com.
OPENAI_BASE_URL=
# Dashboard owners: these emails are always admin (comma separated). Everyone else signs up as "user" and waits for approval.
ADMIN_EMAILS=
ACCOUNT_COUNT=4
TIMEZONE=Africa/Lagos
COMPANY_NAME=OIC Solar
SENDER_NAME=Ade
# Optional. Leave empty to stay 100% free (OpenStreetMap only).
GOOGLE_MAPS_API_KEY=
