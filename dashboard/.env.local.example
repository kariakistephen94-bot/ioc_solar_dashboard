# Where the engine runs, and the same token as engine/.env ENGINE_API_TOKEN
ENGINE_URL=http://127.0.0.1:3310
ENGINE_API_TOKEN=

# Staff sign-in (Supabase Auth). Same project as the engine.
# Supabase -> Project Settings -> API: Project URL and the anon / publishable key (NOT the service_role key).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Anyone can create an account, but only admins can open the dashboard. Owners (always admin) are set
# with ADMIN_EMAILS in engine/.env; they approve everyone else on the Team page.
# Only for a local demo with no Supabase: DASHBOARD_AUTH=off. Never set this on a deployed dashboard.
DASHBOARD_AUTH=
